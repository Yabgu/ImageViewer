{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja (default)",
      "description": "Default config using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
      }
    },
    {
      "name": "no-viewer",
      "displayName": "Ninja — no viewer",
      "description": "Build without the GUI viewer (format lib + tests only)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-no-viewer",
      "cacheVariables": {
        "IMAGEVIEWER_BUILD_VIEWER": "OFF"
      }
    }
  ]
}
