[Desktop Entry]
Type=Application
Version=1.5
Name=ImageViewer
GenericName=Image Viewer
Comment=View images and IWI textures
Exec=iview %F
TryExec=iview
Icon=iview
Terminal=false
Categories=Graphics;Viewer;
Keywords=image;picture;photo;viewer;texture;iwi;tension;
StartupNotify=true
StartupWMClass=ImageViewer
MimeType=image/png;image/jpeg;image/webp;image/tiff;image/gif;image/bmp;image/x-tga;image/vnd.radiance;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-iwi;
